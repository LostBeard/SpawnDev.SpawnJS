<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Version>2.1.10-local.2</Version>
		<PackageReleaseNotes>v2.1.9 - The app-root resolver no longer identifies the framework folder by NAME. A published app can rename _framework (SpawnJSWebWorkersFrameworkFolderName), which made AppBaseUri resolve to the framework folder itself and every URL built on it one level too deep - worker entrypoints 404'd, presenting as a crashed renderer rather than a clean error. The folder is now identified by WHAT was loaded from it. Adds public SpawnJSInterop.appRootFromLoadUrl(url). No change for a normal _framework publish.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.SpawnJS</Title>
		<Authors>LostBeard</Authors>
		<Description>Full .Net WebAssembly and Javascript interop. Supports all Javascript data types and web browser APIs. Call constructors, call methods, access properties, and add/remove event handlers of Javascript objects the .Net way without writing Javascript.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.SpawnJS</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.SpawnJS.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>blazor blazor-wasm webassembly javascript interop js-interop webapi js-wrapper strongly-typed browser-api web-workers</PackageTags>
		<CompressionEnabled>false</CompressionEnabled>
		<IsTrimmable>true</IsTrimmable>
	</PropertyGroup>

	<PropertyGroup>
		<StaticWebAssetBasePath Condition="$(StaticWebAssetBasePath) == ''">/</StaticWebAssetBasePath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.BackgroundServices" Version="2.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<!-- Preserves wrapper .ctor(SpawnJSObjectReference) + accessors under trimming (built via Activator.CreateInstance in SpawnJSObjectMarshaller). Ships in the package so consumers can PublishTrimmed. -->
		<EmbeddedResource Include="ILLink.Descriptors.xml">
			<LogicalName>ILLink.Descriptors.xml</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

</Project>
