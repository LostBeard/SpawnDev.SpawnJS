<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Version>3.0.1-local.1</Version>
		<PackageReleaseNotes>v3.0.0 - One crossing per call: arguments, POCOs, arrays and results travel in a per-instance call tape in .NET memory, read by Javascript in a single JSImport. Callback arguments reach .NET memory before the call. POCO codecs are generated at compile time (SpawnDev.SpawnJS.Generators ships in this package; [SpawnJSPoco] for runtime-only types). Breaking for custom marshallers only: the contract is Write(JSTape, T) / Schema / Read(ref JSTapeReader) - NetToJS is gone. See CHANGELOG.md.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.SpawnJS</Title>
		<Authors>LostBeard</Authors>
		<Description>Full .Net WebAssembly and Javascript interop. Supports all Javascript data types and web browser APIs. Call constructors, call methods, access properties, and add/remove event handlers of Javascript objects the .Net way without writing Javascript.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.SpawnJS</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.SpawnJS.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>blazor blazor-wasm webassembly javascript interop js-interop webapi js-wrapper strongly-typed browser-api web-workers</PackageTags>
		<CompressionEnabled>false</CompressionEnabled>
		<IsTrimmable>true</IsTrimmable>
	</PropertyGroup>

	<PropertyGroup>
		<StaticWebAssetBasePath Condition="$(StaticWebAssetBasePath) == ''">/</StaticWebAssetBasePath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.BackgroundServices" Version="2.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<!-- The POCO codec generator: runs on this library, and ships in the package so it runs on every consumer -->
		<ProjectReference Include="..\SpawnDev.SpawnJS.Generators\SpawnDev.SpawnJS.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<None Include="..\SpawnDev.SpawnJS.Generators\bin\$(Configuration)\netstandard2.0\SpawnDev.SpawnJS.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- Preserves wrapper .ctor(SpawnJSObjectReference) + accessors under trimming (built via Activator.CreateInstance in SpawnJSObjectMarshaller). Ships in the package so consumers can PublishTrimmed. -->
		<EmbeddedResource Include="ILLink.Descriptors.xml">
			<LogicalName>ILLink.Descriptors.xml</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

</Project>
